# ─────────────────────────────────────────────────────────────
#  Verdance backend — environment configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (MySQL). With the bundled docker-compose this works as-is.
DATABASE_URL="mysql://verdance:verdance@localhost:3306/hair_oil_store"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Set to "none" (and COOKIE_SECURE=true) when the frontend and API are on different domains.
COOKIE_SAMESITE=lax

# CORS / frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Shipping / store rules
STORE_CURRENCY=USD
FREE_SHIPPING_THRESHOLD=50
STANDARD_SHIPPING_FEE=5

# Cash on Delivery
COD_ENABLED=true
COD_MAX_ORDER=500
COD_FEE=0

# Multi-currency. STORE_CURRENCY (above) is the BASE all prices are stored in.
# FX_RATES = units of each currency per 1 base unit. Adjust to your real rates.
SUPPORTED_CURRENCIES=USD,PKR,EUR,GBP,AED
FX_RATES={"USD":1,"PKR":278,"EUR":0.92,"GBP":0.79,"AED":3.67}

# Seed admin (development only — change before any real deployment)
SEED_ADMIN_EMAIL=admin@verdance.test
SEED_ADMIN_PASSWORD=ChangeMe_Admin123
SEED_ADMIN_FIRST_NAME=Store
SEED_ADMIN_LAST_NAME=Admin

# Email (SMTP). Leave blank in dev to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Verdance <no-reply@verdance.test>"

# Payments (placeholder — provider integration added later)
PAYMENT_PROVIDER=mock
